# ChipAgent OpenROAD/OpenSTA adapter image
#
# This image intentionally does not build OpenROAD from source. It wraps an
# existing runtime image that already contains `openroad` and `sta`, then adds
# the same non-root working convention used by the base ChipAgent image.
#
# Example:
#   docker build \
#     --build-arg OPENROAD_BASE_IMAGE=openroad/orfs:latest \
#     -t chipagent/openroad:latest -f Dockerfile.openroad .

ARG OPENROAD_BASE_IMAGE=openroad/orfs:latest
FROM ${OPENROAD_BASE_IMAGE}

SHELL ["/bin/bash", "-lc"]

# ORFS' bundled Yosys frontend only implements a subset of SystemVerilog.
# Install a pinned sv2v binary so package/struct-heavy RTL (for example
# CVFPU) can be lowered reproducibly before synthesis.
ARG SV2V_VERSION=v0.0.13
ARG SV2V_LINUX_ZIP_SHA256=552799a1d76cd177b9b4cc63a3e77823a3d2a6eb4ec006569288abeff28e1ff8
COPY .eda-cache/sv2v-Linux.zip /tmp/sv2v-Linux.zip
RUN set -eux; \
    archive=/tmp/sv2v-Linux.zip; \
    echo "${SV2V_LINUX_ZIP_SHA256}  ${archive}" | sha256sum -c -; \
    python3 -c 'import zipfile; zipfile.ZipFile("/tmp/sv2v-Linux.zip").extract("sv2v-Linux/sv2v", "/tmp")'; \
    install -m 0755 /tmp/sv2v-Linux/sv2v /usr/local/bin/sv2v; \
    rm -rf "${archive}" /tmp/sv2v-Linux; \
    sv2v --version

RUN set -eux; \
    if [[ -f /OpenROAD-flow-scripts/env.sh ]]; then source /OpenROAD-flow-scripts/env.sh; fi; \
    command -v openroad; \
    command -v sta; \
    openroad -version; \
    sta -version

RUN cat >/usr/local/bin/openroad <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
if [[ -f /OpenROAD-flow-scripts/env.sh ]]; then
  source /OpenROAD-flow-scripts/env.sh >/dev/null
fi
PATH="$(printf '%s' "$PATH" | tr ':' '\n' | grep -vx /usr/local/bin | paste -sd: -)"
exec openroad "$@"
EOF
RUN chmod +x /usr/local/bin/openroad

RUN cat >/usr/local/bin/sta <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
if [[ -f /OpenROAD-flow-scripts/env.sh ]]; then
  source /OpenROAD-flow-scripts/env.sh >/dev/null
fi
PATH="$(printf '%s' "$PATH" | tr ':' '\n' | grep -vx /usr/local/bin | paste -sd: -)"
exec sta "$@"
EOF
RUN chmod +x /usr/local/bin/sta

RUN if ! id chipagent >/dev/null 2>&1; then useradd -m -s /bin/bash chipagent; fi
USER chipagent
WORKDIR /work

CMD ["sh"]
